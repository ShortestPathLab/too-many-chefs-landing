---
import { NAV } from "@config";

export interface Props {
  // For use inside the hero tile: drops the outer padding and centres the links.
  inset?: boolean;
}

const { inset = false } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class:list={[
    "flex flex-wrap items-center gap-x-8 gap-y-2",
    !inset && "px-2 py-1.5",
  ]}
>
  <nav
    class:list={[
      "flex flex-wrap justify-center gap-2",
      inset ? "mx-auto" : "ml-auto",
    ]}
  >
    {NAV.map(({ href, label }) => (
      <a
        href={href}
        aria-current={current === href ? "page" : undefined}
        class="bg-navy-raised hover:bg-line aria-[current=page]:bg-pink aria-[current=page]:text-navy flex min-h-11 items-center rounded-xl px-3 sm:px-4"
      >
        {label}
      </a>
    ))}
  </nav>
</header>
