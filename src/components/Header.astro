---
import { NAV, SITE } from "@config";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="mx-auto flex w-full max-w-5xl items-center gap-6 px-4 py-4">
  <a href="/" class="font-semibold">
    {SITE.title}
  </a>
  <nav class="ml-auto flex gap-4">
    {NAV.map(({ href, label }) => (
      <a href={href} aria-current={current === href ? "page" : undefined}>
        {label}
      </a>
    ))}
  </nav>
</header>
