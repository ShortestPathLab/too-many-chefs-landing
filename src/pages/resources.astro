---
import ResourceTile from "@components/ResourceTile.astro";
import Layout from "@layouts/Layout.astro";
import { RESOURCES } from "@config";
---

<Layout title="Resources">
  <div class="tile px-9 py-10">
    <h1 class="title text-7xl">Resources</h1>
  </div>
  <section class="grid gap-4 sm:grid-cols-2">
    {RESOURCES.map(resource => (
      <ResourceTile resource={resource} showDesc class="min-h-44 !py-7" />
    ))}
  </section>
</Layout>
