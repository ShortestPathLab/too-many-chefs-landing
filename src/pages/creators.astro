---
import Layout from "@layouts/Layout.astro";
import { CREATORS } from "@config";
---

<Layout title="Creators">
  <div class="tile px-9 py-10">
    <h1 class="title text-7xl">Creators</h1>
  </div>
  <section class="grid gap-4 sm:grid-cols-2">
    {CREATORS.map(creator => (
      <div class="tile flex min-h-44 flex-col justify-end gap-1 p-7">
        <h2 class="title text-4xl">{creator.name}</h2>
        <p class="text-muted">{creator.affiliation}</p>
      </div>
    ))}
  </section>
</Layout>
